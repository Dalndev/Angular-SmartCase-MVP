{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "~ui": ["libs/ui/src/index.ts"],
      "~domain/*": ["apps/smartcase/src/app/domain/*"],
      "~infra/*": ["apps/smartcase/src/app/infrastructure/*"],
      "~application/*": ["apps/smartcase/src/app/application/*"],
      "~data/*": ["apps/smartcase/src/app/data/*"],
      "~presentation": [""],
      "~cases/*": ["apps/smartcase/src/app/packages/cases/*"]
    }
  }
}
