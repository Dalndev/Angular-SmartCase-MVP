{
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "emitDeclarationOnly": false,
    "importHelpers": true,
    "isolatedModules": true,
    "lib": ["es2022", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2022",
    "customConditions": ["@org/source"],
    "baseUrl": ".",
    "rootDir": ".",
    "paths": {
      "@smartcase/ui": ["libs/ui/src/index.ts"],
      "@smartcase/domain/*": ["apps/smartcase/src/app/domain/*"],
      "@smartcase/infra/*": ["apps/smartcase/src/app/infrastructure/*"],
      "@smartcase/application/*": ["apps/smartcase/src/app/application/*"],
      "@smartcase/data/*": ["apps/smartcase/src/app/data/*"],
      "@smartcase/presentation/*": ["apps/smartcase/src/app/presentation/*"],
    }
  }
}
